# ServiceNow instance URL
SN_INSTANCE=https://inforsaas.service-now.com/

# ── Auth: choose ONE of the two options below ──────────────────────────────

# Option A — Basic auth (username + password). Simpler for local dev.
# Set SN_AUTH_MODE=basic and fill in credentials.
SN_AUTH_MODE=basic
SN_USER=justin.chick@infor.com
SN_PASSWORD=superBaseballs2002!

# Option B — OAuth 2.0 Authorization Code flow.
# Create an OAuth Application Registry record in ServiceNow:
#   System OAuth > Application Registry > New >
#   "Create an OAuth API endpoint for external clients"
#   Redirect URL: http://localhost:3000/auth/callback
# Then set SN_AUTH_MODE=oauth and fill in the values below.
# SN_AUTH_MODE=oauth
# SN_CLIENT_ID=your_client_id_here
# SN_CLIENT_SECRET=your_client_secret_here
# SN_REDIRECT_URI=http://localhost:3000/auth/callback

# Session secret — any long random string
SESSION_SECRET=change_me_to_a_long_random_string

# Anthropic API key — required for AI Insights tab
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server port
PORT=3000

# ── Jira Integration ────────────────────────────────────────────────────────
# Required to enable the "Create Jira Ticket" feature.
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token-here
