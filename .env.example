# Jira Cloud credentials for the Vite dev-server proxy (npm run dev only).
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# These keys are intentionally NOT prefixed with VITE_ so Vite never exposes
# them to the client bundle — they are read by vite.config.js (Node side) only
# and used to inject an Authorization header on the /api/jira proxy.
#
# The API token is created at:
#   https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_BASE_URL=https://infor.atlassian.net
