# Local Jira credentials for the Vite dev proxy. This file is gitignored, so
# it never gets committed. The token is read once when `npm run dev` starts
# and injected into the /api/jira proxy server-side — it never reaches the
# browser bundle.
#
# This is a static, long-lived token: set it once and leave it. To change it,
# edit the value below and restart the dev server.

JIRA_BASE_URL=https://infor.atlassian.net
JIRA_EMAIL=<REDACTED_EMAIL>
JIRA_API_TOKEN=<REDACTED_API_TOKEN>
JIRA_PROJECT_KEY=HMS
