# Jira Cloud credentials for the Vite dev-server proxy (npm run dev only).
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# These keys are intentionally NOT prefixed with VITE_ so Vite never exposes
# them to the client bundle — they are read by vite.config.js (Node side) only
# and used to inject an Authorization header on the /api/jira proxy.
#
# The API token is created at:
#   https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_BASE_URL=https://infor.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-atlassian-api-token-here
JIRA_PROJECT_KEY=HMS

# ---------------------------------------------------------------------------
# AI insights proxy (SECURITY #1).
#
# The AI feature posts a scrubbed case payload to a FIRST-PARTY backend proxy,
# which holds the model API key, re-scrubs PII server-side, and talks to the
# model vendor. Set this to the base URL of that proxy (the client calls
# `${VITE_AI_PROXY_URL}/api/insights`).
#
# This MUST be your own backend service. NEVER point it at api.anthropic.com
# (or any vendor API) directly — doing so would ship an API key into the
# browser bundle and exfiltrate raw customer data. Leave it blank/unset to
# keep the AI feature disabled (the default).
#
# Unlike the JIRA_* keys, this IS prefixed with VITE_ because the proxy URL
# (not a secret) is needed in the client bundle.
VITE_AI_PROXY_URL=
